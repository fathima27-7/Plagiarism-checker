# PlagiScan AI Environment Configuration Template
# Copy this file to .env and customize values for production deployment

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=plagiscan-ai-secret-key-cse-2026

# Database configuration
DATABASE_URL=sqlite:///plagiscan.db

# Storage Directories
UPLOAD_FOLDER=uploads/documents
TEMP_FOLDER=uploads/temp
REFERENCE_FOLDER=reference_documents
GENERATED_REPORTS_FOLDER=generated_reports

# Algorithmic Thresholds
PLAGIARISM_MATCH_THRESHOLD=0.55
AI_FLAG_THRESHOLD=0.65
MAX_CONTENT_LENGTH=16777216
